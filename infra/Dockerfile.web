FROM node:24-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci --ignore-scripts
COPY packages/contracts packages/contracts
COPY apps/web apps/web

# Railway passes service variables as build args. Only browser-public values belong here.
ARG NEXT_PUBLIC_API_BASE
ARG NEXT_PUBLIC_SUI_RPC=https://fullnode.testnet.sui.io:443
ARG NEXT_PUBLIC_SUI_PACKAGE_ID
ARG NEXT_PUBLIC_WALRUS_AGGREGATOR
ARG NEXT_PUBLIC_WALRUS_PUBLISHER
ARG NEXT_PUBLIC_SEAL_SERVER_IDS
ARG NEXT_PUBLIC_SEAL_THRESHOLD=2
RUN node -e "const value = process.env.NEXT_PUBLIC_API_BASE; let valid = false; try { const url = new URL(value); valid = url.protocol === 'https:' && url.origin === value; } catch {} if (!valid) { console.error('Set web service variable NEXT_PUBLIC_API_BASE to the API public HTTPS origin, without a trailing slash, then rebuild.'); process.exit(1); }"
RUN npm run build --workspace @everyday/contracts && npm run build --workspace @everyday/web

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace @everyday/web --workspace @everyday/contracts && npm cache clean --force
COPY --from=build /app/packages/contracts/dist packages/contracts/dist
COPY --from=build --chown=node:node /app/apps/web/.next apps/web/.next
COPY --from=build /app/apps/web/public apps/web/public
COPY --from=build /app/apps/web/next.config.mjs apps/web/next.config.mjs
USER node
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "apps/web", "--hostname", "0.0.0.0"]
