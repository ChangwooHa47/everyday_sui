FROM eclipse-temurin:21-jdk-jammy AS spring-build
WORKDIR /build
COPY apps/api/spring/ .
# Railway requires cache IDs scoped to the destination service; variables are unsupported here.
RUN --mount=type=cache,id=s/f072158e-6d6b-45e7-8463-9bc50eae499e-/root/.gradle,target=/root/.gradle,sharing=locked \
    sed -i 's/\r$//' gradlew && chmod +x gradlew && ./gradlew bootJar --no-daemon --max-workers=1

FROM spring-build AS spring-test
RUN --mount=type=cache,id=s/f072158e-6d6b-45e7-8463-9bc50eae499e-/root/.gradle,target=/root/.gradle,sharing=locked \
    ./gradlew test --no-daemon --max-workers=1

FROM eclipse-temurin:21-jre-jammy AS java-runtime

FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci --ignore-scripts --workspace @everyday/api --workspace @everyday/contracts
COPY packages/contracts packages/contracts
COPY apps/api/tsconfig.json apps/api/tsconfig.json
COPY apps/api/src apps/api/src
RUN npm run build --workspace @everyday/contracts && npm run build --workspace @everyday/api

FROM node:24-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=java-runtime /opt/java/openjdk /opt/java/openjdk
ENV NODE_ENV=production JAVA_HOME=/opt/java/openjdk PATH="/opt/java/openjdk/bin:${PATH}"
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace @everyday/api --workspace @everyday/contracts && npm cache clean --force
COPY --from=build /app/packages/contracts/dist packages/contracts/dist
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=spring-build /build/build/libs/everyday.jar apps/api/spring/everyday.jar
COPY infra/start-backend.mjs infra/start-backend.mjs
USER node
EXPOSE 3001
CMD ["/usr/bin/tini", "--", "node", "infra/start-backend.mjs"]
