# Browser-public configuration. Rebuild after changing. Never put secrets here.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001
NEXT_PUBLIC_SUI_RPC=https://fullnode.testnet.sui.io:443
# Verified TESTNET package; must match the API's SUI_MARKET_PACKAGE_ID.
NEXT_PUBLIC_SUI_PACKAGE_ID=0x3ff2bfc626a8b26ca76eb13045009f642103a7a623188794f5b534882d210023
# All services must belong to the same testnet deployment. No default upload destination.
NEXT_PUBLIC_WALRUS_AGGREGATOR=
NEXT_PUBLIC_WALRUS_PUBLISHER=
# Two or more independently operated, verified testnet Seal key-server object IDs.
NEXT_PUBLIC_SEAL_SERVER_IDS=
NEXT_PUBLIC_SEAL_THRESHOLD=2
