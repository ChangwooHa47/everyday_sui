{
  "name": "@everyday/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @everyday/contracts",
    "dev": "tsx watch src/server.ts",
    "dev:local": "tsx src/local.ts",
    "dev:configured": "node --env-file=.env.local --import tsx src/local.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@everyday/contracts": "0.1.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@mysten-incubation/memwal": "0.1.6",
    "@mysten/seal": "1.4.8",
    "@mysten/sui": "^2.29.0",
    "fastify": "5.12.3",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
