# These are process variables. No implicit dotenv loading.
# Railway supplies PORT; it takes precedence over local API_PORT.
# Production defaults to 0.0.0.0. Do not copy the local API_HOST below to Railway.
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgresql://everyday:everyday-local-only@127.0.0.1:5432/everyday
WEB_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3002
API_AUDIENCE=http://127.0.0.1:3001
# Verified testnet publication; see contracts/everyday/deployments/testnet.json.
SUI_MARKET_PACKAGE_ID=0x3ff2bfc626a8b26ca76eb13045009f642103a7a623188794f5b534882d210023
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
# Optional server-side OpenAI-compatible chat-completions provider. All three required.
# AI_ENDPOINT=https://your-provider.example/v1/chat/completions
# AI_MODEL=your-model
# AI_API_KEY=your-secret
AI_DAILY_LIMIT=50
# Across all wallets and API replicas, counted requests (not a currency budget).
AI_GLOBAL_DAILY_LIMIT=100
# Existing Claude account can also serve market preview/chat when AI_* is absent.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# SPRING_API_URL=http://127.0.0.1:8080
# Spring image provider; Compose forwards these only to the private Spring service.
# HIGGSFIELD_API_KEY=
# HIGGSFIELD_API_SECRET=

# Server-only operator key (suiprivkey1...). Never put this in apps/web env.
# SUI_OPERATOR_KEY=
# Both server configs use weight 1; committee servers also require aggregatorUrl.
# SEAL_SERVERS_JSON=[{"objectId":"0x...","weight":1},{"objectId":"0x...","weight":1}]
SEAL_THRESHOLD=2
# WALRUS_PUBLISHER=https://your-testnet-publisher
# WALRUS_AGGREGATOR=https://your-testnet-aggregator
WALRUS_EPOCHS=7
MARKET_PREVIEW_TURNS=3

# Generate once and keep in a secret store: random 32 bytes, hex encoded (64 chars).
# Rotating this key changes each user's delegate; users must authorize the new public key.
# MEMWAL_DELEGATE_MASTER_KEY=
MEMWAL_SERVER_URL=https://relayer-staging.memory.walrus.xyz
# Must match the live relayer /config packageId, NOT an old copied example.
# Verified with real remember/recall on 2026-09-12; recheck the relayer before configuring.
MEMWAL_PACKAGE_ID=0x0a625e2db2af6f591a4c80a3d8551ddf11656089cc3a20c5e9e7f8fb75b9265c
MEMWAL_REGISTRY_ID=0x736aef9906798fca4460490ccdf8e8502ef170122dc26ecae32111b78c6b42dd

# P1: enables Node market turns' decision/execution only, not Spring product chat.
# Spring chat triggers and gift fulfillment/receipts are still unconnected.
# The operator needs test SUI for gas, and Listing must allow an active GiftProduct.
AGENT_GIFTS_ENABLED=0
